# Copy to .env.local and fill in. Never commit the real file.

# Resend (https://resend.com) sends the enquiry forms.
RESEND_API_KEY=
# The verified address the form emails are sent from, e.g. forms@your-domain.com
RESEND_DOMAIN=

# Optional. Where enquiries are delivered. The defaults are set in app/api/contact/route.ts.
# CONTACT_INBOX_GENERAL=
# CONTACT_INBOX_FRANCHISE=
